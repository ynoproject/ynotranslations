#. ID 1
msgctxt "skills.name"
msgid "Awaken"
msgstr "Thức dậy"

#. ID 1
msgctxt "skills.description"
msgid "Return to the waking world."
msgstr "Trở về thế giới thực."

#. ID 1
msgctxt "items.name"
msgid "Dust Bunny"
msgstr "Thỏ Bụi"

#. ID 1
msgctxt "items.description"
msgid "Become a dust bunny. Makes you lighter and faster."
msgstr "Biến thành chú thỏ bụi. Làm bản thân nhẹ và nhanh hơn."

#. ID 2
msgctxt "items.name"
msgid "Vampirism"
msgstr "Ma Cà Rồng"

#. ID 2
msgctxt "items.description"
msgid "Become able to take blood from others."
msgstr "Nhận khả năng cướp máu từ những sinh vật khác."

#. ID 3
msgctxt "items.name"
msgid "Scooter"
msgstr "Xe Máy"

#. ID 3
msgctxt "items.description"
msgid "Ride a scooter. A more orthodox way to go faster."
msgstr "Lái chiếc xe máy. Một cách truyền thống hơn để đi nhanh."

#. ID 4
msgctxt "items.name"
msgid "Mobile Phone"
msgstr "Điện Thoại"

#. ID 4
msgctxt "items.description"
msgid "Hold a mobile phone. Allows you to call home."
msgstr "Cầm chiếc điện thoại di động. Cho phép gọi về nhà."

#. ID 5
msgctxt "items.name"
msgid "Tuning Fork"
msgstr "Âm Thoa"

#. ID 5
msgctxt "items.description"
msgid "Wield a tuning fork. Things may react to its use."
msgstr "Mang theo chiếc âm thoa. Có những thứ sẽ phản ứng với nó."

#. ID 6
msgctxt "items.name"
msgid "Angler"
msgstr "Đèn Lồng"

#. ID 6
msgctxt "items.description"
msgid "Hold a bathyal lantern. Its odd light is alluring."
msgstr "Cầm chiếc đèn lồng. Ánh sáng nó phát ra thật thu hút."

#. ID 7
msgctxt "items.name"
msgid "Bed Hair"
msgstr "Tóc Xù"

#. ID 7
msgctxt "items.description"
msgid "Get bed hair. Not much of a morning person..."
msgstr "Làm xù tóc lên. Không thích dậy sớm cho lắm..."

#. ID 8
msgctxt "items.name"
msgid "Deer"
msgstr "Con Nai"

#. ID 8
msgctxt "items.description"
msgid "Become a deer. Allows you to jump some small gaps."
msgstr "Biến thành chú nai. Cho phép nhảy qua vài quãng ngắn."

#. ID 9
msgctxt "items.name"
msgid "Skeleton Key"
msgstr "Chìa Khóa Xương"

#. ID 9
msgctxt "items.description"
msgid "Become a lockpick demon. Open the unopenable."
msgstr "Biến thành chú quỷ đi phá khóa. Mở mọi cánh cửa."

#. ID 10
msgctxt "items.name"
msgid "Gargoyle"
msgstr ""

#. ID 10
msgctxt "items.description"
msgid "Become a statue. May protect you from danger."
msgstr "Biến thành bức tượng. Bảo vệ bản thân khỏi hiểm nguy."

#. ID 11
msgctxt "items.name"
msgid "Wendigo"
msgstr ""

#. ID 11
msgctxt "items.description"
msgid "Become a monster. Lets you mimic some creatures."
msgstr "Biến thành quái thú. Hóa thân thành một số vật khác."

#. ID 12
msgctxt "items.name"
msgid "Ice Sculpture"
msgstr "Tượng Đá"

#. ID 12
msgctxt "items.description"
msgid "Become an ice sculpture. Stops things from moving."
msgstr "Biến thành bức tượng đá. Khiến mọi vật bất động."

#. ID 13
msgctxt "items.name"
msgid "Brimstone"
msgstr "Lưu Huỳnh"

#. ID 13
msgctxt "items.description"
msgid "Become infernal stone. Incinerates other things."
msgstr "Biến thành đá âm phủ. Nung cháy những thứ khác."

#. ID 14
msgctxt "items.name"
msgid "Bellhop"
msgstr "Khuân Vác"

#. ID 14
msgctxt "items.description"
msgid "Become a hotel porter. Lets you push stuff around."
msgstr "Biến thành nhân viên khuân vác. Đưa đẩy những thứ khác."

#. ID 15
msgctxt "items.name"
msgid "Formal"
msgstr "Lễ Phục"

#. ID 15
msgctxt "items.description"
msgid "Wear formal clothes. Looks a bit uptight."
msgstr "Mặc bộ lễ phục. Trông lịch sự hơn."

