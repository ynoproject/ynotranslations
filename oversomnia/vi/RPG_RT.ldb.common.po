msgid "\\C[19]Not enough money."
msgstr "\\C[19]Không đủ tiền rồi."

#. ID 66, Line 1
msgid "\\C[19]You already own this effect."
msgstr "\\C[19]Cậu có sẵn hiệu ứng này rồi."

