#. ID 62, Line 3
msgid ""
"\\C[19]...Are you alright?\\.\\. You look like you're worried\n"
"about something,\\.\\. are you-\\^"
msgstr ""
"\\C[19]...Cậu ổn chứ?\\.\\. Cậu trông có vẻ lo lắng\n"
"vì chuyện gì đó,\\.\\. có phải-\\^"

#. ID 62, Line 5
msgid "\\C[19]...\\. What's up?"
msgstr "\\C[19]...\\. Chào nhé."

#. ID 62, Line 12
msgid "\\C[19]Hey.\\. What's up?"
msgstr "\\C[19]Ê.\\. Khỏe chứ?"

#. ID 62, Line 18
msgid "\\C[19]That's pretty cute.\\. What's up?"
msgstr "\\C[19]Đáng yêu phết.\\. Sao vậy?"

#. ID 62, Line 24
msgid "\\C[19]Don't do anything you'll regret."
msgstr "\\C[19]Đừng có làm gì mà sau này phải hối hận nhé."

#. ID 62, Line 30
msgid "\\C[19]Does that work here?\\. Anyway, what's up?"
msgstr "\\C[19]Cái đó có dùng được ở đây không vậy?\\.\n"
"Mà kệ đi, dạo này thế nào rồi?"

#. ID 62, Line 36
msgid "\\C[19]I used to have one of those, too.\\. What's up?"
msgstr "\\C[19]Có đợt tớ cũng từng có một cái như vậy.\\. Ổn không?"

#. ID 62, Line 42
msgid "\\C[19]No need to be formal...\\. What's up?"
msgstr "\\C[19]Không cần lịch thiệp quá đâu...\\. Cậu khỏe không?"

#. ID 62, Line 48
msgid "\\C[19]Doors are often locked for a reason, you know."
msgstr "\\C[19]Có mấy cánh cửa khóa là có lí do cả đấy,\\.\n"
"cậu hiểu mà."

#. ID 62, Line 54
msgid "\\C[19]Good morning.\\. What's up?"
msgstr "\\C[19]Chào buổi sáng.\\. Cậu như nào rồi?"

#. ID 62, Line 60
msgid "\\C[19]Doesn't that hurt?"
msgstr "\\C[19]Bị như thế có đau không?"

#. ID 62, Line 66
msgid "\\C[19]A deer, of course...\\. What's up?"
msgstr "\\C[19]Một con nai, phải rồi...\\. Sao vậy?"

#. ID 62, Line 72
msgid "\\C[19]Isn't it hard to move like that?"
msgstr "\\C[19]Di chuyển như vậy khó khăn lắm chứ nhỉ?"

#. ID 62, Line 78
msgid "\\C[19]..."
msgstr ""

#. ID 62, Line 84
msgid "\\C[19]I'm not hiring at the moment.\\. Anyway, what's up?"
msgstr "\\C[19]Tớ đang không tuyển thêm người.\\.\n"
"Mà cậu dạo này sao rồi?"

#. ID 62, Line 91
msgid "\\C[19]Oh? A true work of art...\\.Anyway, what's up?"
msgstr "\\C[19]Hửm? Đúng là kiệt tác đi mà...\\. Mà cậu thế nào rồi?"

#. ID 62, Line 95
msgid "\\C[19]It's so cold...\\. Make it quick, please."
msgstr "\\C[19]Lạnh quá...\\. Làm nhanh cho xong đi nhé."

#. ID 62, Line 103
msgid "\\C[19]Be careful with that...\\. Anyway, what's up?"
msgstr "\\C[19]Cẩn thận với cái đó nhé...\\. Mà cậu sao rồi?"

#. ID 62, Line 109
msgid "\\C[19]That thing must have some strong wheels..."
msgstr "\\C[19]Cái đó chắc cũng phải có bánh xe khá bền..."

#. ID 64, Line 1
msgid "\\C[19]Thanks.\\|\\^"
msgstr "\\C[19]Tớ cảm ơn.\\|\\^"

