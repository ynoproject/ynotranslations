#. ID 19, Page 1, Line 9, Pos (37,20)
msgid "\\C[19]Greetings, Irving.\\. What do you need?"
msgstr "\\C[19]Chào Irving.\\. Cậu cần gì nào?"

#. ID 19, Page 1, Line 21, Pos (37,20)
#. Choice (2 options)
msgid ""
"Temporary Effects\n"
"Nevermind"
msgstr ""
"Hiệu Ứng Tạm Thời\n"
"Thôi"

#. ID 19, Page 1, Line 25, Pos (37,20)
msgid ""
"\\C[19]These are temporary effects,\\. they will \n"
"vanish from your memory when you wake up...\\.\\.\n"
"Here's what I'm selling."
msgstr ""
"\\C[19]Những đống này là hiệu ứng tạm thời,\\. \n" 
"chúng sẽ biến mất khỏi kí ức của cậu khi tỉnh dậy\n"
"...\\.\\.\n"
"Tớ có bán mấy thứ này."

#. ID 19, Page 1, Line 33, Pos (37,20)
#. Choice (4 options)
msgid ""
"Speed-Up Effect [10$q]\n"
"Attack Effect   [10$q]\n"
"Escape Effect   [10$q]\n"
"Nevermind"
msgstr ""
"Hiệu Ứng Tăng Tốc   [10$q]\n"
"Hiệu Ứng Tấn Công   [10$q]\n"
"Hiệu Ứng Tẩu Thoát  [10$q]\n"
"Thôi"

