#. ID 1, Page 1, Line 2880, Pos (19,14)
msgid ""
"\\>$s$t$u$v：曲の選択\n"
"\\>Z       ：曲の演奏・No.指定登録\n"
"\\>X       ：メニュー\n"
"\\>Shift   ：曲情報の閲覧・曲の登録\\_/\\_消去"
msgstr ""
"\\>$s$t$u$v: Track Selection\n"
"\\>Z       : Play Track・Reg. Track No.\n"
"\\>X       : Go to Menu\n"
"\\>Shift   : View Track Info・Register"

#. ID 1, Page 1, Line 2886, Pos (19,14)
msgid ""
"\\>$s$t$u$v：曲の選択\n"
"\\>Z       ：曲の演奏・演出切替\n"
"\\>X       ：メニュー\n"
"\\>Shift   ：曲情報の閲覧・曲の登録\\_/\\_消去"
msgstr ""
"\\>$s$t$u$v: Track Selection\n"
"\\>Z       : Play Track・Switch Variant\n"
"\\>X       : Go to Menu\n"
"\\>Shift   : View Track Info・Register"

